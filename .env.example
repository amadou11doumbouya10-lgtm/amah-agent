# Copie ce fichier en .env et remplis tes clés

# --- Groq (obligatoire) ---
# Clé gratuite sur : https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Gmail (optionnel) ---
# Nécessaire uniquement pour les outils email (read_emails, send_email, search_emails)
# Setup :
#   1. Active la validation en 2 étapes sur ton compte Google
#   2. Va dans : Compte Google → Sécurité → Mots de passe des applications
#   3. Crée un mot de passe pour "Autre" → copie le code 16 caractères ci-dessous
GMAIL_ADDRESS=contact.amah.officiel@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- ElevenLabs (optionnel) ---
# Nécessaire uniquement pour les scripts de génération audio dans voix/
# Clé sur : https://elevenlabs.io → Profil → API Keys
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Gemini (optionnel) ---
# Nécessaire uniquement pour le mode voix temps réel "Live"
# Clé gratuite sur : https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Memoire (optionnel) ---
# Duree de conservation des conversations, en jours (0 = toujours).
# Choisie dans l'ecran de configuration ; 365 si absent. Amah s'en sert
# pour se souvenir de vos echanges : plus court = moins de souvenirs.
AMAH_HISTORY_DAYS=365

# --- Initiatives (optionnel, sans appel IA : aucun quota Groq) ---
# Briefing du jour au premier lancement de la journee (date, meteo, emails
# importants non lus, taches planifiees) ; "fais-moi le point" le redonne.
AMAH_BRIEFING=1
# Ville de la meteo du briefing (vide = devinee d'apres la connexion)
AMAH_CITY=
# Alerte (notification + message) quand un email important arrive (Gmail requis)
AMAH_EMAIL_ALERTS=1
AMAH_EMAIL_CHECK_MINUTES=10
# Expediteurs toujours importants : adresses ou domaines, separes par des virgules
AMAH_VIP_EMAILS=

# --- Licence (obligatoire pour les clients) ---
# Fournie par contact.amah.officiel@gmail.com a partir de votre identifiant
# de machine (affiche dans l'ecran de configuration au premier lancement).
AMAH_LICENSE_KEY=

# Developpeur uniquement (jamais chez un client) : cle privee de signature
# des licences, generee avec : py -3.13 tools/license.py --nouvelle-paire
# AMAH_LICENSE_PRIVATE_KEY=
